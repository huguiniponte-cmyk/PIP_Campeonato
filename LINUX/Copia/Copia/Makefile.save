# Makefile para Projeto Copia - Gestão de Campeonatos

# Nome do programa final
TARGET = copia

# Arquivo fonte principal
SRC = Copia.c

# Compilador
CC = gcc

# Opções de compilação
CFLAGS = -Wall -Wextra -std=c99

# Regra principal - compilar o programa
$(TARGET): $(SRC)
	$(CC) $(CFLAGS) -o $(TARGET) $(SRC)

# Limpar arquivos compilados
clean:
	rm -f $(TARGET)

# Executar o programa
run: $(TARGET)
	./$(TARGET)

# Ajuda - mostrar comandos disponíveis
help:
	@echo "Comandos disponíveis:"
	@echo "  make       - Compilar o programa"
	@echo "  make run   - Compilar e executar"
	@echo "  make clean - Remover arquivos compilados"
	@echo "  make help  - Mostrar esta ajuda"

